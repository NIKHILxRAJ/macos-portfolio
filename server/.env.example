# Copy to server/.env and fill in.
PORT=5001

# AI answers (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RATE_LIMIT_PER_MINUTE=15

# Contact messages are saved here. Local: mongodb://127.0.0.1:27017/portfolio
# Cloud: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Deployment
TRUST_PROXY=false
ALLOWED_ORIGINS=
